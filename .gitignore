# MC4HOS build artifacts and tool caches
# NOTE: hvigor model configs (.hvigor/hvigor-config.json5 and
# hvigor/hvigor-config.json5) are COMMITTED — only caches are ignored.
/node_modules
/oh_modules
/local.properties
/.idea
**/build
**/oh_modules
**/.cxx
*.hap
*.hsp
*.app
.cxx
hvigor-wrapper.js
hvigor/hvigor-config.json5.bak

# hvigor daemon state (model configs stay committed)
/.hvigor/*
!/.hvigor/hvigor-config.json5

# local build output
/out

# Node harness output (tests/.build is generated from entry/src/main/ets/core)
/tests/.build
/tests/node_modules

# openharmony-jdk local cross-build work/output (JDK sources, sysroots, images)
openharmony-jdk/work*/
openharmony-jdk/out/
openharmony-jdk/dist/

# ohpm lock files regenerate per-platform; commit none
oh-package-lock.json5
entry/oh-package-lock.json5

# runtime packs fetched at build time and bundled into the HAP (never committed)
/entry/src/main/resources/rawfile/jvm/

# JRE native libraries extracted into the module libs for packaging (generated
# by scripts/bundle_jre_natives.py; never committed)
/entry/libs/

# bridge jar compiled from entry/src/main/cpp/java by scripts/build_bridge_jar.py
/entry/src/main/resources/rawfile/bridge/
